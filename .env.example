# Copie este arquivo para .env e preencha os valores.
# O .env NUNCA deve ir para o Git.

# Servidor
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
# Em produção (Render) defina NODE_ENV=production para o cookie de sessão exigir HTTPS
NODE_ENV=

# Segredos (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
JWT_SECRET=

# Banco de dados MySQL (Clever Cloud)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# O Clever Cloud permite 5 conexões por usuário: use 4 em produção e 1 em desenvolvimento
DB_CONNECTION_LIMIT=1

# Administrador do painel
ADMIN_USER=
ADMIN_PASS=

# Envio de e-mails: EMAIL_PROVIDER=brevo ou resend
# Brevo: remetente validado em Senders (pode ser um Gmail)
# Resend: exige domínio verificado para enviar a qualquer pessoa
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=EcoGeneration <ecogeneration7777@gmail.com>
