<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pedidos — Admin EcoGeneration</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="icon" href="/imagens/favicon2.png" type="image/png">
  <!-- simple-notify para Flash Messages -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.css">
  <style>
    .badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .badge-aguardando_pagamento { background: #fff8e1; color: #8a5a00; }
    .badge-pago        { background: #e8f5e9; color: #1b5e20; }
    .badge-confirmado  { background: #e8f5e9; color: #2e7d32; }
    .badge-enviado     { background: #e3f2fd; color: #1565c0; }
    .badge-entregue    { background: #f3e5f5; color: #6a1b9a; }
    .badge-cancelado   { background: #ffebee; color: #c62828; }

    .status-form { display: flex; gap: 0.5rem; align-items: center; }
    .status-form select {
      padding: 0.3rem 0.5rem;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 0.85rem;
    }
    .status-form button {
      padding: 0.3rem 0.75rem;
      background: #2e7d32;
      color: #fff;
      border: none;
      border-radius: 6px;
      font-size: 0.85rem;
      cursor: pointer;
    }
    .status-form button:hover { background: #1b5e20; }

    .produto-thumb {
      width: 44px;
      height: 44px;
      object-fit: contain;
      border-radius: 6px;
      background: #f5f5f5;
      padding: 2px;
    }
  </style>
</head>

<section class="admin-wrapper">
  <aside class="admin-sidebar">
    
    <nav class="admin-nav">
      <a href="/admin" class="nav-item">Dashboard</a>
      <a href="/admin/usuarios" class="nav-item">Usuários</a>
      <a href="/admin/diagnosticos" class="nav-item">Diagnósticos</a>
      <a href="/admin/produtos" class="nav-item">Produtos</a>
      <a href="/admin/pedidos" class="nav-item active">Pedidos</a>
      <a href="/admin-logout" class="nav-item nav-logout">Sair</a>
    </nav>
  </aside>

  <main class="admin-main">
    <header class="admin-header">
      <h1>Gerenciamento de Pedidos</h1>
      <p>Total de pedidos: <strong><%= pedidos.length %></strong></p>
    </header>

    <% if (pedidos.length > 0) { %>
      <section class="table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Pedido</th>
              <th>Itens</th>
              <th>Cliente</th>
              <th>Total</th>
              <th>Pagamento</th>
              <th>Status</th>
              <th>Alterar status</th>
            </tr>
          </thead>
          <tbody>
            <% pedidos.forEach(pedido => { %>
              <tr>
                <td>
                  #<%= pedido.id_pedido %>
                  <small style="display:block; color:#555;"><%= pedido.data_pedido ? new Date(pedido.data_pedido).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) : 'data não registrada' %></small>
                </td>
                <td>
                  <% pedido.itens.forEach(item => { %>
                    <span style="display:flex; align-items:center; gap:0.5rem; margin:2px 0;">
                      <img src="/imagens/<%= item.imagem_produto %>" alt="" class="produto-thumb">
                      <%= item.nome_produto %>
                    </span>
                  <% }) %>
                </td>
                <td>
                  <%= pedido.nome_usuario || 'Visitante' %>
                  <small style="display:block; color:#555;"><%= pedido.email_usuario || '' %></small>
                </td>
                <td>R$ <%= Number(pedido.total_pedido).toFixed(2).replace('.', ',') %></td>
                <td>
                  <%= rotuloPagamento[pedido.status_pagamento] || pedido.status_pagamento %>
                  <% if (pedido.id_pagamento) { %><small style="display:block; color:#555;">ID <%= pedido.id_pagamento %></small><% } %>
                </td>
                <td>
                  <span class="badge badge-<%= pedido.status_pedido %>">
                    <%= rotuloStatus[pedido.status_pedido] || pedido.status_pedido %>
                  </span>
                </td>
                <td>
                  <form method="POST" action="/admin/pedidos/<%= pedido.id_pedido %>/status" class="status-form">
                    <select name="status" aria-label="Novo status do pedido #<%= pedido.id_pedido %>">
                      <% statusPedido.forEach(st => { %>
                        <option value="<%= st %>" <%= pedido.status_pedido === st ? 'selected' : '' %>><%= rotuloStatus[st] %></option>
                      <% }) %>
                    </select>
                    <button type="submit">Salvar</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    <% } else { %>
      <p style="text-align:center; color:#999; padding:3rem;">Nenhum pedido encontrado.</p>
    <% } %>
  </main>
</section>

<!-- simple-notify JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.min.js"></script>
<!-- Função centralizada de notificações -->
<script src="/js/notify.js"></script>
<!-- Flash Message -->
<%- include('../partials/flash') %>

</body>
</html>
