<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="keywords" content="dashboard, painel administrativo, gestão, controle, EcoGeneration">
    <meta name="description" content="Painel de controle administrativo - EcoGeneration">
    <title>adm</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/admin.css">
      <link rel="icon" href="/imagens/favicon2.png" type="image/png">
  <!-- simple-notify para Flash Messages -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.css">
</head>
<body>
  <aside class="admin-sidebar">
   
    
    <nav class="admin-nav">
      <a href="/admin" class="nav-item <%= currentPath === '/admin' ? 'active' : '' %>">
        Dashboard
      </a>
      <a href="/admin/usuarios" class="nav-item <%= currentPath === '/admin/usuarios' ? 'active' : '' %>">
        Usuários
      </a>
      <a href="/admin/diagnosticos" class="nav-item <%= currentPath === '/admin/diagnosticos' ? 'active' : '' %>">
        Diagnósticos
      </a>
      <a href="/admin/produtos" class="nav-item <%= currentPath === '/admin/produtos' ? 'active' : '' %>">
        Produtos
      </a>
      <a href="/admin/pedidos" class="nav-item">
        Pedidos
      </a>
      <a href="/admin-logout" class="nav-item nav-logout">
        Sair
      </a>
    </nav>
  </aside>
  
  <main class="admin-main">
    <header class="admin-header">
      <h1>Dashboard de Administração</h1>
     
    </header>
    
    <section class="dashboard-stats">
      <article class="stat-card">
        <span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
        <section class="stat-content">
          <h3>Usuários Cadastrados</h3>
          <p class="stat-number"><%= totalUsuarios %></p>
        </section>
      </article>
      
      <article class="stat-card">
        <span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M9 12h6M9 16h6"/></svg></span>
        <section class="stat-content">
          <h3>Diagnósticos Realizados</h3>
          <p class="stat-number"><%= totalDiagnosticos %></p>
        </section>
      </article>
      
      <article class="stat-card">
        <span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></span>
        <section class="stat-content">
          <h3>Pedidos Realizados</h3>
          <p class="stat-number"><%= typeof totalPedidos !== 'undefined' ? totalPedidos : 0 %></p>
        </section>
      </article>

      <article class="stat-card">
        <span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12"/></svg></span>
        <section class="stat-content">
          <h3>Produtos em Catálogo</h3>
          <p class="stat-number"><%= totalProdutos %></p>
        </section>
      </article>

       
      
      <article class="stat-card <%= produtosBaixoEstoque.length > 0 ? 'warning' : '' %>">
        <span class="stat-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg></span>
        <section class="stat-content">
          <h3>Produtos Baixo Estoque</h3>
          <p class="stat-number"><%= produtosBaixoEstoque.length %></p>
        </section>
      </article>
    </section>
    
  

    
   
  </main>
</section>

<!-- simple-notify JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.min.js"></script>
<!-- Função centralizada de notificações -->
<script src="/js/notify.js"></script>
<!-- Flash Message -->
<%- include('../partials/flash') %>

</body>
</html>