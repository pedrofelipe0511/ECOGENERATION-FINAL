<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>adm</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" href="/imagens/favicon2.png" type="image/png">
  <!-- simple-notify para Flash Messages -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.css">
</head>
<body>

<section class="admin-wrapper">
  <aside class="admin-sidebar">
    <nav class="admin-nav">
      <a href="/admin" class="nav-item">
        📊 Dashboard
      </a>
      <a href="/admin/usuarios" class="nav-item">
        👥 Usuários
      </a>
      <a href="/admin/diagnosticos" class="nav-item active">
        📋 Diagnósticos
      </a>
      <a href="/admin/produtos" class="nav-item">
        📦 Produtos
      </a>
      <a href="/admin/pedidos" class="nav-item">
        🛒 Pedidos
      </a>
      <a href="/admin-logout" class="nav-item nav-logout">
        🚪 Sair
      </a>
    </nav>
  </aside>
  
  <main class="admin-main">
    <header class="admin-header">
      <h1>📋 Gerenciamento de Diagnósticos</h1>
      <p>Total de diagnósticos realizados: <strong><%= diagnosticos.length %></strong></p>
    </header>
    
    <% if (diagnosticos.length > 0) { %>
      <section class="table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Usuário</th>
              <th>Email</th>
              <th>Nível de Autonomia</th>
              <th>Data do Diagnóstico</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% diagnosticos.forEach(diag => { %>
              <tr>
                <td>#<%= diag.id_diagnostico %></td>
                <td><%= diag.nome_usuario || "Anônimo" %></td>
                <td><%= diag.email_usuario || "-" %></td>
                <td>
                  <span class="badge badge-<%= diag.nivel_autonomia %>">
                    <%= diag.nivel_autonomia %>
                  </span>
                </td>
                <td>—</td>
                <td>
                  <form method="POST" action="/admin/diagnosticos/deletar/<%= diag.id_diagnostico %>" class="form-inline"
                        onsubmit="return confirm('Tem certeza que deseja deletar este diagnóstico?')">
                    <button type="submit" class="btn btn-tiny btn-danger">🗑️ Deletar</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </section>
    <% } else { %>
      <section class="empty-state">
        <p>📭 Nenhum diagnóstico realizado ainda</p>
        <a href="/diagnostico" class="btn btn-primary">Realizar Diagnóstico</a>
      </section>
    <% } %>
  </main>
</section>

<!-- simple-notify JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.min.js"></script>
<!-- Função centralizada de notificações -->
<script src="/js/notify.js"></script>
<!-- Flash Message -->
<%- include('../partials/flash') %>

</body>
</html>
