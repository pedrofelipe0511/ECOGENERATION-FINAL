<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="keywords" content="admin, login administrativo, painel controle, EcoGeneration">
  <meta name="description" content="Área de login administrativo - EcoGeneration">
  <title><%= titulo %> - ECOGENERATION</title>
  <link rel="stylesheet" href="/css/admin.css">
    <link rel="icon" href="/imagens/favicon2.png" type="image/png">
  <!-- simple-notify para Flash Messages -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.css">
</head>
<body class="admin-body">
  <main class="admin-container">
    <section class="admin-login-box" aria-label="Login administrativo">
      <header class="admin-header">
        <h1>ADMIN ECOGENERATION</h1>
      
      </header>
      
      <% if (erro) { %>
        <aside class="alert alert-error" role="alert">
          <%= erro %>
        </aside>
      <% } %>
      
      <form method="POST" action="/admin-login" class="admin-form">
        <fieldset class="form-group">
          <label for="usuario">Usuário</label>
          <input 
            type="text" 
            id="usuario" 
            name="usuario" 
            placeholder="Digite o usuário" 
            required
          >
        </fieldset>
        
        <fieldset class="form-group">
          <label for="senha">Senha</label>
          <input 
            type="password" 
            id="senha" 
            name="senha" 
            placeholder="Digite a senha" 
            required
          >
          <label class="mostrar-senha-label">
            <input type="checkbox" onchange="toggleSenha('senha', this)"> Mostrar senha
          </label>
        </fieldset>
        
        <button type="submit" class="btn btn-primary btn-block">
          Entrar
        </button>
      </form>
      
      <footer class="admin-footer">
        <a href="/">Voltar à página inicial</a>
      </footer>
    </section>
  </main>

  <!-- simple-notify JavaScript -->
  <script src="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.min.js"></script>
  <!-- Função centralizada de notificações -->
  <script src="/js/notify.js"></script>
  <!-- Flash Message -->
  <%- include('../partials/flash') %>
</body>
</html>
