<!DOCTYPE html>
<html lang="pt-br">

<head>
 <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="keywords" content="diagnóstico, calculadora, energia solar, autonomia energética, sustentabilidade">
  <meta name="description" content="Inicie seu diagnóstico de autonomia energética - Descubra qual tipo de energia renovável é ideal para você.">
  <title>Diagnóstico de Autonomia Energética — EcoGeneration</title>
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/calculadora.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="apple-touch-icon" href="/imagens/favicon2.png">
  <link rel="icon" href="/imagens/favicon2.png" type="image/png">

  <!-- Open Graph (OG) — cartão de visitas nas redes sociais -->
  <meta property="og:locale" content="pt_BR">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Diagnóstico de Autonomia Energética — EcoGeneration">
  <meta property="og:description" content="Faça seu diagnóstico energético e descubra as melhores soluções solares para sua casa.">
  <meta property="og:url" content="https://ecogeneration-final-4hh3.onrender.com/diagnostico">
  <meta property="og:site_name" content="EcoGeneration">
  <meta property="og:image" content="https://ecogeneration-final-4hh3.onrender.com/imagens/og-cover-v2.png">
  <meta property="og:image:secure_url" content="https://ecogeneration-final-4hh3.onrender.com/imagens/og-cover-v2.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="EcoGeneration — Autonomia Energética">
  <!-- Twitter/X Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Diagnóstico de Autonomia Energética — EcoGeneration">
  <meta name="twitter:description" content="Faça seu diagnóstico energético e descubra as melhores soluções solares para sua casa.">
  <meta name="twitter:image" content="https://ecogeneration-final-4hh3.onrender.com/imagens/og-cover-v2.png">
  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2e7d32">
  <!-- simple-notify para Flash Messages -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.css">
</head>
<body>
  <%- include("../partials/header") %>

  <main class="eco-main" id="conteudo-principal">
    <article class="eco-calculator-section">
      <h1 class="calculator-hero-title">Faça seu Diagnóstico Energético</h1>
      <p class="calculator-hero-description">Responda algumas perguntas rápidas e descubra as melhores soluções solares para sua casa.</p>
      
      <ul class="calculator-options">
        <li class="option-item">Análise personalizada</li>
        <li class="option-item">Recomendações adaptadas</li>
        <li class="option-item">Mais autonomia</li>
      </ul>

      <p class="calculator-time">Leva menos de 1 minuto</p>

      <form action="/diagnostico" method="get">
        <button class="calculator-btn-start" type="submit">COMEÇAR</button>
      </form>
    </article>
    
  </main>
   
  <%- include("../partials/footer") %>
  <!-- simple-notify JavaScript -->
  <script src="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.min.js"></script>
  <!-- Função centralizada de notificações -->
  <script src="/js/notify.js"></script>
  <!-- Flash Message -->
  <%- include("../partials/flash") %>
</body>
</html>