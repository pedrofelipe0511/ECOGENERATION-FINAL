<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resultado do Diagnóstico — EcoGeneration</title>
  <meta name="description" content="Veja seu nível de autonomia energética e os produtos recomendados especialmente para você pela EcoGeneration.">
  <meta name="robots" content="noindex, follow">
  <link rel="canonical" href="https://ecogeneration-final-4hh3.onrender.com/diagnostico">
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/resultado.css">
  <link rel="apple-touch-icon" href="/imagens/favicon2.png">
  <link rel="icon" href="/imagens/favicon2.png" type="image/png">
  <!-- Open Graph -->
  <meta property="og:locale" content="pt_BR">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Resultado do Diagnóstico — EcoGeneration">
  <meta property="og:description" content="Veja seu nível de autonomia energética e os produtos recomendados especialmente para você.">
  <meta property="og:url" content="https://ecogeneration-final-4hh3.onrender.com/diagnostico">
  <meta property="og:site_name" content="EcoGeneration">
  <meta property="og:image" content="https://ecogeneration-final-4hh3.onrender.com/imagens/og-cover-v2.png">
  <meta property="og:image:secure_url" content="https://ecogeneration-final-4hh3.onrender.com/imagens/og-cover-v2.png">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="EcoGeneration — Resultado do Diagnóstico Energético">
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Resultado do Diagnóstico — EcoGeneration">
  <meta name="twitter:description" content="Veja seu nível de autonomia energética e produtos recomendados para você.">
  <meta name="twitter:image" content="https://ecogeneration-final-4hh3.onrender.com/imagens/og-cover-v2.png">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2e7d32">
  <!-- simple-notify para Flash Messages -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.css">
</head>
<body>

  <%- include('../partials/header') %>

  <main class="resultado-container" id="conteudo-principal" tabindex="-1">

    <section class="resultado-header">
      <h1>Resultado do Diagnóstico</h1>
    </section>

    <%
      const brl = (valor) => Number(valor).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
      const linkComprarKit = (kit) => '/confirmar-kit?' + kit.itens.map((p) => 'item=' + p.id_produto).join('&');
      const marcador = { ok: { simbolo: '✅', texto: 'Coberto' }, parcial: { simbolo: '⚠️', texto: 'Cobre em parte' }, nao: { simbolo: '❌', texto: 'Não coberto' } };
      const vulnLabel = vulnerabilidade >= 7 ? 'Alta' : vulnerabilidade >= 3 ? 'Média' : 'Baixa';
      const prepLabel = preparo >= 7 ? 'Alto'  : preparo >= 3 ? 'Médio' : 'Baixo';
    %>

    <!-- Resultado do perfil -->
    <section aria-live="assertive" aria-atomic="true" class="resultado-perfil">

      <% if (perfil === 'independente') { %>
        <article class="resultado alta" role="status">
          <section class="resultado-body" aria-label="Resumo do resultado">
            <h2>Parabéns — você já é independente da rede!</h2>
            <p>Você já conta com uma boa estrutura de proteção energética. O kit abaixo complementa o que você já tem.</p>
          </section>
        </article>

      <% } else if (perfil === 'critico') { %>
        <article class="resultado baixa" role="status">
          <span class="resultado-icon" aria-hidden="true">⚠️</span>
          <section class="resultado-body" aria-label="Resumo do resultado">
            <h2>Situação crítica de dependência</h2>
            <p>Você sofre com quedas frequentes ou longas e ainda não tem proteção. A boa notícia: pequenas soluções já fazem grande diferença — e custam menos do que você imagina.</p>
          </section>
        </article>

      <% } else if (perfil === 'medio') { %>
        <article class="resultado media" role="status">
          <span class="resultado-icon" aria-hidden="true">⚡</span>
          <section class="resultado-body" aria-label="Resumo do resultado">
            <h2>Você está no caminho certo</h2>
            <p>Você tem alguma proteção, mas ainda é vulnerável em quedas mais longas ou frequentes. O kit abaixo fecha essa lacuna.</p>
          </section>
        </article>

      <% } else { %>
        <article class="resultado media" role="status">
          <span class="resultado-icon" aria-hidden="true">🌱</span>
          <section class="resultado-body" aria-label="Resumo do resultado">
            <h2>Hora de se preparar antes de precisar</h2>
            <p>Você raramente enfrenta quedas agora, mas estar preparado custa muito menos do que remediar depois. Veja abaixo um kit simples para começar.</p>
          </section>
        </article>
      <% } %>

      <!-- Medidores das duas dimensões -->
      <section class="dimensoes" aria-label="Detalhes do seu diagnóstico">

        <figure class="dimensao">
          <figcaption class="dimensao-titulo">Vulnerabilidade a quedas</figcaption>
          <meter class="barra-vuln"
                 min="0" max="10"
                 value="<%= vulnerabilidade %>"
                 aria-label="Vulnerabilidade: <%= vulnLabel %>">
          </meter>
          <output class="dimensao-valor"><%= vulnLabel %></output>
        </figure>

        <figure class="dimensao">
          <figcaption class="dimensao-titulo">Preparo atual</figcaption>
          <meter class="barra-prep"
                 min="0" max="10"
                 value="<%= preparo %>"
                 aria-label="Preparo: <%= prepLabel %>">
          </meter>
          <output class="dimensao-valor"><%= prepLabel %></output>
        </figure>

      </section>


    </section>

    <!-- Feedback de salvamento -->
    <% if (diagnosticoSalvo) { %>
    <section class="diagnostico-salvo" role="status" aria-label="Diagnóstico salvo">
      <p>✓ Seu diagnóstico foi salvo com sucesso no seu perfil.</p>
    </section>
    <% } %>

    <!-- Kit recomendado -->
    <section class="plano" aria-labelledby="titulo-plano">
      <h2 id="titulo-plano">Seu kit para quando a luz cair</h2>

      <% if (plano.kit) { %>
        <article class="kit">
          <header class="kit-cabecalho">
            <p class="kit-total"><%= brl(plano.kit.total) %></p>
            <p class="kit-orcamento"><%= plano.teto ? 'dentro do seu orçamento' : 'o melhor kit para o que você precisa' %></p>
          </header>

          <ul class="kit-itens">
            <% plano.kit.itens.forEach(function(produto) { %>
              <li class="kit-item">
                <img src="/imagens/<%= produto.imagem_produto %>" alt="" loading="lazy">
                <section class="kit-item-info" aria-label="<%= produto.nome_produto %>">
                  <h3><%= produto.nome_produto %></h3>
                  <p><%= brl(produto.preco_produto) %></p>
                </section>
                <a href="/produto/<%= produto.id_produto %>" class="kit-item-link" aria-label="Ver <%= produto.nome_produto %>">Ver produto</a>
              </li>
            <% }); %>
          </ul>

          <h3 class="kit-subtitulo">Com ele você mantém:</h3>
          <ul class="kit-cobertura">
            <% plano.kit.cobertura.forEach(function(item) { %>
              <li class="cobertura <%= item.status %>">
                <span class="cobertura-status" aria-hidden="true"><%= marcador[item.status].simbolo %></span>
                <span class="visually-hidden"><%= marcador[item.status].texto %>:</span>
                <span class="cobertura-texto"><span aria-hidden="true"><%= item.icone %></span> <strong><%= item.nome %></strong>: <%= item.frase %></span>
              </li>
            <% }); %>
          </ul>

          <a href="<%= linkComprarKit(plano.kit) %>" class="btn-comprar-kit">Comprar kit por <%= brl(plano.kit.total) %></a>
        </article>
      <% } else { %>
        <p class="kit-vazio">
          Não encontramos um kit <%= plano.teto ? 'de até ' + brl(plano.teto) : '' %> que mantenha esses aparelhos funcionando.
          <% if (!plano.alternativa) { %><a href="/ecoloja">Veja todos os produtos na EcoLoja</a>.<% } %>
        </p>
      <% } %>

      <% if (plano.alternativa) { %>
        <aside class="kit-alternativa" aria-labelledby="titulo-alternativa">
          <h3 id="titulo-alternativa">Para manter tudo funcionando</h3>
          <p>
            Este kit de <strong><%= brl(plano.alternativa.total) %></strong> cobre todos os aparelhos que você escolheu<%= plano.teto ? ', mas passa do seu orçamento' : '' %>:
          </p>
          <ul class="kit-alternativa-itens">
            <% plano.alternativa.itens.forEach(function(produto) { %>
              <li><a href="/produto/<%= produto.id_produto %>"><%= produto.nome_produto %></a> — <%= brl(produto.preco_produto) %></li>
            <% }); %>
          </ul>
          <a href="<%= linkComprarKit(plano.alternativa) %>" class="btn-comprar-alternativa">Comprar este kit</a>
        </aside>
      <% } %>

      <p class="kit-aviso">Estimativa feita com o consumo médio de cada aparelho. O tempo real pode variar conforme o modelo e o uso.</p>
    </section>

    <!-- Ações pós-resultado -->
    <nav class="acoes" aria-label="Ações pós-diagnóstico">
      <a href="/diagnostico" class="btn-voltar">Refazer Diagnóstico</a>
      <a href="/ecoloja" class="btn-home">Ver toda a loja</a>
    </nav>

  </main>

  <%- include('../partials/footer') %>
  <!-- simple-notify JavaScript -->
  <script src="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.min.js"></script>
  <!-- Função centralizada de notificações -->
  <script src="/js/notify.js"></script>
  <!-- Flash Message -->
  <%- include('../partials/flash') %>

</body>
</html>
