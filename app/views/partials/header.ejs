<header class="site-header">
  <section class="header-container" aria-label="Cabeçalho principal">
    <figure class="logo-figure">
      <a href="/">
        <img src="/imagens/GENERATIONN.svg" alt="EcoGeneration Logo" class="logo">
      </a>
    </figure>

    <button type="button" class="hamburger" id="hamburger" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-categorias">
      <span></span><span></span><span></span>
    </button>

    <section class="header-actions" aria-label="Menu principal e ações do usuário">
      <nav class="nav-categorias" id="nav-categorias" aria-label="Navegação principal">
        <ul>
          <li class="<%= currentPath === '/ecoloja' ? 'active' : '' %>">
            <a href="/ecoloja">Loja</a>
          </li>
          <li class="<%= currentPath === '/diagnostico' ? 'active' : '' %>">
            <a href="/diagnostico">Diagnóstico</a>
          </li>
        
          <% if (typeof usuarioLogado !== 'undefined' && usuarioLogado) { %>
            <li>
              <a href="/logout">Sair</a>
            </li>
          <% } else { %>        
            <li class="<%= currentPath === '/cadastro' ? 'active' : '' %>">
              <a href="/cadastro">Cadastrar</a>
            </li>
          <% } %>
          <!-- No celular o tema fica aqui dentro, para a logo ter espaço no topo -->
          <li class="nav-tema">
            <button type="button" class="dark-toggle dark-toggle-menu" aria-label="Alternar modo escuro">
              <span class="nav-tema-texto">Modo escuro</span>
              <span class="toggle-switch"></span>
            </button>
          </li>
        </ul>
      </nav>

      <section class="search-actions" aria-label="Busca e acesso da conta">
        <form action="/search" method="get" class="search-form" aria-label="Buscar produtos">
          <input type="search" name="q" placeholder="Buscar produtos..." aria-label="Buscar produtos" enterkeyhint="search" autocomplete="off" />
          <button type="submit" class="search-btn" aria-label="Pesquisar">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </button>
        </form>
        <% const qtdeNoCarrinho = typeof qtdeCarrinho !== 'undefined' ? qtdeCarrinho : 0; %>
        <a href="/carrinho" class="carrinho-link" aria-label="Carrinho: <%= qtdeNoCarrinho %> <%= qtdeNoCarrinho === 1 ? 'item' : 'itens' %>">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <% if (qtdeNoCarrinho > 0) { %><span class="carrinho-qtde" aria-hidden="true"><%= qtdeNoCarrinho > 99 ? '99+' : qtdeNoCarrinho %></span><% } %>
        </a>
        <% const logado = typeof usuarioLogado !== 'undefined' && usuarioLogado;
           const primeiroNome = logado ? (usuarioNome ? usuarioNome.split(' ')[0] : 'Usuário') : ''; %>
        <a href="<%= logado ? '/perfil' : '/login' %>" class="login-btn login-header-btn<%= logado ? ' logado' : '' %>" aria-label="<%= logado ? 'Minha conta (' + primeiroNome + ')' : 'Entrar na conta' %>">
          <% if (logado) { %>
            <span class="login-avatar" aria-hidden="true"><%= primeiroNome.charAt(0).toUpperCase() %></span>
          <% } else { %>
            <svg class="login-icone" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          <% } %>
          <span class="login-texto"><%= logado ? 'Olá, ' + primeiroNome : 'Entrar' %></span>
        </a>
        <button type="button" class="dark-toggle" id="darkToggle" aria-label="Alternar modo escuro">
          <span class="toggle-switch"></span>
        </button>
      </section>
    </section>
  </section>
  
</header>